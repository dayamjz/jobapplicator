# OpenAI (default model for generation)
OPENAI_API_KEY=sk-...

# Anthropic (fallback when rate limited)
ANTHROPIC_API_KEY=sk-ant-...

# GitHub (for PR creation and push)
GITHUB_TOKEN=ghp_...
GITHUB_REPO_OWNER=your-username
GITHUB_REPO_NAME=Applicator

# Optional: override config path
# CONFIG_PATH=./config.json
