{
  "name": "job-applicator",
  "version": "0.1.0",
  "description": "LinkedIn, Indeed & Greenhouse job applicator with Ralph loop",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
